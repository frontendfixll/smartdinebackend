# Use only for the separate local Pinky Promise database.
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
MONGODB_URI=mongodb://127.0.0.1:27017/pinky_promise_local?replicaSet=pinky-local&directConnection=true
JWT_ACCESS_SECRET=replace-with-a-random-local-secret
JWT_REFRESH_SECRET=replace-with-another-random-local-secret
JWT_GUEST_SECRET=replace-with-a-third-random-local-secret
PUBLIC_BASE_URL=http://localhost:4000
GUEST_APP_URL=http://localhost:5174
DASHBOARD_URL=http://localhost:5174/admin
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe (US card processor). Use test keys locally (sk_test_... / pk_test_...).
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` or the dashboard webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

LOCAL_OWNER_EMAIL=owner@pinky.local
LOCAL_OWNER_NAME=Pinky Promise Owner
LOCAL_OWNER_PASSWORD=replace-with-your-own-local-password
