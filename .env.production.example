# ─────────────────────────────────────────────────────────────────────────────
# Pinky Promise — PRODUCTION environment template
# Copy the values into your host's secret manager (Render dashboard env vars,
# etc.). DO NOT commit a filled-in copy. See docs/PRODUCTION_SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# ── Core ────────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (must be a replica set — transactions need it).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pinky_promise?retryWrites=true&w=majority

# Three DISTINCT random secrets (>=32 chars). Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_GUEST_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Production URLs / CORS (your real domains).
PUBLIC_BASE_URL=https://api.yourdomain.com
GUEST_APP_URL=https://yourdomain.com
DASHBOARD_URL=https://yourdomain.com/admin
CORS_ORIGIN=https://yourdomain.com

# ── Payments — Stripe (LIVE keys) ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Image hosting — Cloudinary ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pinky_promise

# ── SMS / WhatsApp — Twilio ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# ── Email — SMTP (SendGrid / SES / etc.) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pinky Promise <no-reply@yourdomain.com>

# ── Web push — VAPID (generate a NEW pair for production) ────────────────────
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@yourdomain.com

# ── Error monitoring — Sentry (optional) ────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
